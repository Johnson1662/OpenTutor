{
  "name": "opentutor",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @opentutor/server --filter @opentutor/web dev",
    "dev:web": "pnpm --filter @opentutor/web dev",
    "dev:server": "pnpm --filter @opentutor/server dev",
    "build": "pnpm --filter @opentutor/web build",
    "typecheck:server": "pnpm --filter @opentutor/server typecheck"
  }
}
